{
  "name": "Portfólio Pessoal (Java 25)",
  "image": "mcr.microsoft.com/devcontainers/java:3-25",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Portfólio",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "chmod +x mvnw && ./mvnw -B -q dependency:go-offline"
}
